UploadError:"\xa1Algo sali\xf3 mal! Int\xe9ntalo de nuevo"},creditPurchaseModal:{title:"Comprar cr\xe9ditos Mint",currentCreditsLabel:"Cr\xe9ditos actuales:",selectAmountLabel:"Selecciona la cantidad a comprar:",creditSingular:"cr\xe9dito",creditPlural:"cr\xe9ditos",continueToPayment:"Continuar al pago",cancelButton:"Cancelar",maxCreditsError:"Ya tienes el m\xe1ximo de cr\xe9ditos.",maxPurchasableError_one:"Puedes comprar hasta {{count}} cr\xe9dito.",maxPurchasableError_other:"Puedes comprar hasta {{count}} cr\xe9ditos.",confirmPurchaseTitle:"Confirmar compra",confirmPurchaseMessage_one:"\xbfComprar {{count}} cr\xe9dito adicional?",confirmPurchaseMessage_other:"\xbfComprar {{count}} cr\xe9ditos adicionales?",confirmCancel:"Cancelar",confirmPurchase:"Comprar",onboardingIncomplete:"La configuraci\xf3n de Stripe a\xfan no est\xe1 completa."},reportFlow:{sheetTitle:"Reportar este contenido",sheetSubtitle:"Ay\xfadanos a entender por qu\xe9 est\xe1s reportando esto",confirmTitle:"Reportar este contenido",confirmSubtitle:"Tomamos tus comentarios en serio",reasonLabel:"Motivo del reporte:",submitButton:"Enviar reporte",submittingButton:"Enviando...",cancelButton:"Cancelar",missingPostIdTitle:"No se puede reportar",missingPostIdMessage:"Falta el ID de la publicaci\xf3n.",noReasonTitle:"Selecciona un motivo",noReasonMessage:"Por favor elige un motivo para este reporte.",successTitle:"Reporte enviado",successMessage:"\xa1Gracias! Tu reporte ha sido enviado.",failedTitle:"Error al reportar",reason1:"Es spam",reason2:"Desnudez o contenido sexual",reason3:"Discurso de odio o s\xedmbolos",reason4:"Violencia o comportamiento peligroso",reason5:"Informaci\xf3n falsa",reason6:"Acoso o intimidaci\xf3n",reason7:"Estafa o fraude"},shareModal:{searchPlaceholder:"Buscar",noFollowingFound:"No se encontraron usuarios seguidos",sendButton_one:"Enviar a {{count}} usuario",sendButton_other:"Enviar a {{count}} usuarios",shareToLabel:"Compartir con",copyLinkLabel:"Copiar enlace",whatsappLabel:"WhatsApp",copiedTitle:"\xa1Copiado!",copiedMessage:"Enlace copiado al portapapeles",invalidLinkTitle:"Error",invalidLinkMessage:"Enlace compartido inv\xe1lido",loadFollowingError:"Error al cargar la lista de seguidos",noSelectionTitle:"Sin selecci\xf3n",noSelectionMessage:"Por favor selecciona al menos un usuario.",notLoggedInTitle:"Sesi\xf3n no iniciada",notLoggedInMessage:"Por favor inicia sesi\xf3n nuevamente.",sentTitle:"Enviado",sentMessage_one:"Compartido con {{count}} usuario.",sentMessage_other:"Compartido con {{count}} usuarios.",shareErrorTitle:"Error",shareErrorMessage:"Error al compartir",navigationErrorTitle:"Error",navigationErrorMessage:"La navegaci\xf3n fall\xf3."},requestModal:{pendingTitle:"Solicitud pendiente",pendingSubtitle:"Aprueba o rechaza en tu billetera si se te solicita.",resultTitle:"Resultado"},storyViewer:{unknownUser:"Usuario desconocido",videoStoryBadge:"\ud83c\udfac Historia en video",photoStoryBadge:"\ud83d\udcf7 Historia en foto",timeJustNow:"Ahora mismo",timeMinutesAgo:"Hace {{count}} min",timeHoursAgo:"Hace {{count}} h",timeDaysAgo:"Hace {{count}} d",timeRecently:"Recientemente"},subscribeFlow:{step1Subtitle:"\xa1Est\xe1s a punto de suscribirte!",step1Body:"Desbloquea publicaciones exclusivas, drops privados y acceso directo al mundo Valens de este creador.\n\nTu apoyo se convierte en recompensas en tiempo real \u2014 cada suscripci\xf3n impulsa su camino y el tuyo.",confirmQuestion:"\xbfConfirmar suscripci\xf3n?",yesButton:"S\xed, me apunto",notNow:"Ahora no",membershipLabel:"Membres\xeda",perMonth:"/ mes",commentLabel:"Comentario:",termsPrefix:"Acepto los",termsLink:"T\xe9rminos para Suscriptores de Valens",termsSuffix:"y entiendo que las suscripciones solo brindan acceso a contenido digital y no son inversiones ni productos financieros.",completePaymentButton:"\u2705 Hecho \u2014 Completar pago",subscriptionAmountNotSet:"Este creador a\xfan no ha establecido un monto de suscripci\xf3n.",amountUnavailable:"El importe de la suscripci\xf3n no est\xe1 disponible. Int\xe9ntalo de nuevo.",onboardingIncomplete:"La configuraci\xf3n de Stripe a\xfan no est\xe1 completa."},subscriptionActivation:{title:"Convi\xe9rtete en suscriptor privado",chargeIntro:"Se cobrar\xe1 una tarifa mensual de",chargeAmount:"$19.90",chargeSuffix:"para activar tu cuenta privada de suscriptor.",platformFeesTitle:"Tarifas de la plataforma",maintenanceFee:"\u2022 Tarifa mensual de mantenimiento de $19.90",maintenanceFeeDesc:"Para alojar y operar tu canal privado de suscripci\xf3n.",withdrawalFee:"\u2022 Comisi\xf3n de retiro del ",withdrawalFeeDesc:"Aplicada a cada solicitud de pago que realices.",billingAuthTitle:"Autorizaci\xf3n de facturaci\xf3n",billingAuthDesc:"Al continuar, autorizas a Valens a cobrar autom\xe1ticamente la tarifa mensual de mantenimiento y deducir la comisi\xf3n de retiro del de tus pagos.",cancelButton:"Cancelar",acceptButton:"Aceptar"},stripePaymentMethod:{message:"Completa la configuraci\xf3n de Stripe para agregar un m\xe9todo de pago.",cancelButton:"Cancelar",connectButton:"Conectar con Stripe"},supportCreator:{disclaimerTitle:"\xbfApoyar a \"{{creatorName}}\"?",disclaimerDescription:"Est\xe1s a punto de enviar apoyo voluntario a este perfil.\nSolo para que lo sepas:",bullet1:"Esta es una acci\xf3n no financiera y no una inversi\xf3n.",bullet2:"No se esperan ni ofrecen ganancias, recompensas ni beneficios financieros.",bullet3:"Tu apoyo es una contribuci\xf3n voluntaria.",bullet4:"Cualquier elemento digital asociado (si aplica) no es transferible y no tiene valor de reventa.",bullet5:"Los fondos se env\xedan directamente desde tu billetera a la billetera del creador.",bullet6:"Valens no custodia, retiene ni administra fondos de usuarios.",disclaimerNote:"Al continuar, confirmas que entiendes que esta es una contribuci\xf3n voluntaria sin expectativas financieras.",connectWalletButton:"Conectar billetera para continuar",maybeLater:"Quiz\xe1s m\xe1s tarde",introTitle:"\xbfApoyar a este creador?",introDescription:"Tu seguimiento es gratuito. Si quieres, puedes apoyar econ\xf3micamente a {{creatorName}} ahora.",supportNowButton:"Apoyar ahora",nahLater:"No, m\xe1s tarde"},termConditionComponent:{heading:"POL\xcdTICA MAESTRA DE SUSCRIPCI\xd3N DE VALENS",section1Title:"1. Descripci\xf3n general",section1Body:"Esta Pol\xedtica Maestra de Suscripci\xf3n se aplica a todos los usuarios que participan en el ecosistema de suscripci\xf3n de Valens, incluidos los Propietarios de Planes y los Suscriptores. Al activar o suscribirse, los usuarios aceptan esta pol\xedtica, incluidos los T\xe9rminos de Uso, la Pol\xedtica de Privacidad y la Pol\xedtica de Pagos de Valens.",partATitle:"PARTE A \u2014 T\xc9RMINOS PARA LOS PROPIETARIOS DE PLANES",section2Title:"2. Creaci\xf3n del plan de suscripci\xf3n",section2Body:"Cuando activas un plan de suscripci\xf3n, te conviertes en un Propietario de Plan. Puedes crear canales privados, definir beneficios y establecer precios mensuales de suscripci\xf3n entre $9.99 USD y $100.00 USD.",section3Title:"3. Tarifas de la plataforma",section3Sub1Title:"3.1 Tarifa mensual de mantenimiento",section3Sub1Body:"Valens cobra $19.99 USD/mes por alojar y operar tu canal de suscripci\xf3n.",section3Sub2Title:"3.2 Comisi\xf3n de retiro",section3Sub2Body:"Se aplica una comisi\xf3n de retiro del 5% a cada solicitud de pago.",section3Sub3Title:"3.3 Autorizaci\xf3n de facturaci\xf3n",section3Sub3Body:"Al habilitar tu plan, autorizas a Valens a cobrar autom\xe1ticamente las tarifas de mantenimiento y deducir las comisiones de retiro de pagos.",section4Title:"4. Ganancias y pagos",section4Body:"Las ganancias son visibles en el Panel del Creador. Los pagos siguen la Pol\xedtica de Pagos. Se requiere verificaci\xf3n KYC. Debes reportar las ganancias a las autoridades fiscales.",section5Title:"5. Responsabilidades del contenido",section5Body:"Todo el contenido privado debe seguir las directrices de Valens. Est\xe1 prohibido el contenido ilegal, da\xf1ino, abusivo o fraudulento.",section6Title:"6. Cumplimiento y aplicaci\xf3n de la cuenta",section6Body:"Valens puede restringir la monetizaci\xf3n, congelar pagos, eliminar contenido o deshabilitar planes en caso de violaciones.",partBTitle:"PARTE B \u2014 T\xc9RMINOS PARA LOS SUSCRIPTORES",section7Title:"7. Acceso a la suscripci\xf3n",section7Body:"Los suscriptores obtienen acceso a contenido privado exclusivo y beneficios. El acceso no es transferible.",section8Title:"8. Facturaci\xf3n mensual y renovaci\xf3n autom\xe1tica",section8Body:"Al suscribirte, autorizas a Valens a facturarte mensualmente hasta la cancelaci\xf3n.",section9Title:"9. Cancelaci\xf3n",section9Body:"Puedes cancelar en cualquier momento. El acceso permanece hasta el final del per\xedodo de facturaci\xf3n. No hay reembolsos parciales.",section10Title:"10. Sin reembolsos",section10Body:"Todos los pagos de suscripci\xf3n son finales y no reembolsables, incluidos los per\xedodos no utilizados.",section11Title:"11. Protecci\xf3n del contenido",section11Body:"Los suscriptores NO pueden capturar pantalla, grabar, descargar, imprimir ni compartir contenido de suscripci\xf3n. Las violaciones pueden resultar en un bloqueo de seguridad.",partCTitle:"PARTE C \u2014 T\xc9RMINOS GENERALES",section12Title:"12. Seguridad y cumplimiento",section12Body:"Todas las interacciones deben cumplir con las Directrices de la Comunidad Valens y los requisitos legales.",section13Title:"13. Derechos de la plataforma",section13Body:"Valens puede actualizar tarifas, congelar actividades sospechosas, restringir pagos o suspender programas.",section14Title:"14. Aceptaci\xf3n de los t\xe9rminos",section14Body:"Al utilizar las funciones de suscripci\xf3n, aceptas esta pol\xedtica y autorizas a Valens a gestionar cargos y tarifas.",checkboxLabel:"Acepto los T\xe9rminos y Condiciones",continueButton:"Continuar"},tokenPurchase:{loadingPrice:"Cargando precio del token...",title:"Tokens de apoyo",rateLabel:"Tarifa actual: ${{rate}} por token",amountInputLabel:"Monto del valor del token",selectTokensLabel:"Seleccionar tokens",breakdownTitle:"Estructura de tarifas y desglose",tokenValueLabel:"Valor del token",platformFeeLabel:"Tarifa de plataforma (5%)",followingFeeLabel:"Tarifa de seguimiento (5%)",totalPayableLabel:"Monto total a pagar",youWillReceive:"Recibir\xe1s",tokensCount:"{{count}} tokens",info1:"\u2022 La tarifa de plataforma y la tarifa de seguimiento se agregan al valor del token",info2:"\u2022 La cantidad de tokens se calcula a partir del valor del token (antes de las tarifas)",info3:"\u2022 Ajustar el monto o los tokens actualizar\xe1 autom\xe1ticamente el otro valor",purchaseButton:"Comprar tokens",purchaseButtonWithDetails:"Comprar {{count}} tokens por ${{total}}",processingButton:"Procesando...",paymentCompleted:"\xa1Pago completado!",minAmountError:"El monto total a pagar debe ser al menos $0.50",errorTitle:"Error",fetchPriceError:"No se pudo obtener el precio del token"},tokenSell:{loading:"Cargando...",title:"Tokens sin apoyo",availableLabel:"Disponible: {{count}} tokens",tokensToUnsupportLabel:"Tokens a retirar apoyo",usdAmountLabel:"Monto en USD",sellButton:"Retirar apoyo de tokens por ${{total}}",processingButton:"Procesando...",errorTitle:"Error",sellError:"No se pudo procesar la venta de tokens. Verifica tu conexi\xf3n e int\xe9ntalo de nuevo.",fetchAmountError:"No se pudo obtener el monto de compra de tokens",fetchPriceError:"No se pudo obtener el precio del token"},topHolders:{activityTab:"Actividad",holdersTab:"Poseedores",noActivity:"\u2728 A\xfan no hay actividad",noActivitySub:"Compra para iniciar el mercado",buyButton:"Comprar",marketLabel:"Mercado",userLabel:"Usuario",youLabel:"Usuario (t\xfa)"},tradeModal:{followTab:"Seguir",unfollowTab:"Dejar de seguir",sparksLabel:"Sparks",balanceZero:"Saldo: \u27280",balanceLabel:"Saldo: {{amount}}",maxLabel:"M\xe1x",commentPlaceholder:"Agregar un comentario...",followButton:"Seguir",unfollowButton:"Dejar de seguir",sellingUnavailable:"Ve