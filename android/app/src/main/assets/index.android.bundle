:"We take your feedback seriously",reasonLabel:"Reason for report:",submitButton:"Submit Report",submittingButton:"Submitting...",cancelButton:"Cancel",missingPostIdTitle:"Unable to report",missingPostIdMessage:"Missing post id.",noReasonTitle:"Select a reason",noReasonMessage:"Please choose a reason for this report.",successTitle:"Report submitted",successMessage:"Thanks! Your report has been submitted.",failedTitle:"Report failed",reason1:"It's spam",reason2:"Nudity or sexual content",reason3:"Hate speech or symbols",reason4:"Violence or dangerous behaviour",reason5:"False information",reason6:"Bullying or harassment",reason7:"Scam or fraud"},shareModal:{searchPlaceholder:"Search",noFollowingFound:"No following users found",sendButton_one:"Send to {{count}} user",sendButton_other:"Send to {{count}} users",shareToLabel:"Share to",copyLinkLabel:"Copy link",whatsappLabel:"WhatsApp",copiedTitle:"Copied!",copiedMessage:"Link copied to clipboard",invalidLinkTitle:"Error",invalidLinkMessage:"Invalid share link",loadFollowingError:"Failed to load following list",noSelectionTitle:"No Selection",noSelectionMessage:"Please select at least one user.",notLoggedInTitle:"Not logged in",notLoggedInMessage:"Please log in again.",sentTitle:"Sent",sentMessage_one:"Shared with {{count}} user.",sentMessage_other:"Shared with {{count}} users.",shareErrorTitle:"Error",shareErrorMessage:"Failed to share",navigationErrorTitle:"Error",navigationErrorMessage:"Navigation failed."},requestModal:{pendingTitle:"Pending request",pendingSubtitle:"Approve or reject in your wallet if prompted.",resultTitle:"Result"},storyViewer:{unknownUser:"Unknown User",videoStoryBadge:"\ud83c\udfac Video Story",photoStoryBadge:"\ud83d\udcf7 Photo Story",timeJustNow:"Just now",timeMinutesAgo:"{{count}}m ago",timeHoursAgo:"{{count}}h ago",timeDaysAgo:"{{count}}d ago",timeRecently:"Recently"},subscribeFlow:{step1Subtitle:"You're about to Subscribe!",step1Body:"Unlock exclusive posts, private drops, and direct access to this creator's Valens world.\n\nYour support turns into real-time rewards \u2014 every subscription fuels their journey and yours.",confirmQuestion:"Confirm Subscription?",yesButton:"Yes, I'm In",notNow:"Not Now",membershipLabel:"Membership",perMonth:"/ month",commentLabel:"Comment:",termsPrefix:"I agree to the",termsLink:"Valens Subscriber Terms",termsSuffix:"and understand that subscriptions provide access to digital content only and are not investments or financial products.",completePaymentButton:"\u2705 Done \u2014 Complete Payment",subscriptionAmountNotSet:"This creator hasn't set a subscription amount yet.",amountUnavailable:"Subscription amount is not available. Please try again.",onboardingIncomplete:"Stripe onboarding is not complete yet."},subscriptionActivation:{title:"Become a Private Subscriber",chargeIntro:"A monthly fee of",chargeAmount:"$19.90",chargeSuffix:"will be charged to activate your private subscriber account.",platformFeesTitle:"Platform Fees",maintenanceFee:"\u2022 $19.90 Monthly Maintenance Fee",maintenanceFeeDesc:"For hosting and operating your private subscription channel.",withdrawalFee:"\u2022  Withdrawal Fee",withdrawalFeeDesc:"Applied to every payout request you make.",billingAuthTitle:"Billing Authorization",billingAuthDesc:"By continuing, you authorize Valens to automatically charge the monthly maintenance fee and deduct the  withdrawal fee from your payouts.",cancelButton:"Cancel",acceptButton:"Accept"},stripePaymentMethod:{message:"Please complete the Stripe setup to add a payment method.",cancelButton:"Cancel",connectButton:"Connect to Stripe"},supportCreator:{disclaimerTitle:"Support \"{{creatorName}}\" ?",disclaimerDescription:"You're about to send voluntary support to this profile.\nJust so you know:",bullet1:"This is a non-financial action and not an investment.",bullet2:"No profit, rewards, or financial benefits are expected or offered.",bullet3:"Your support is a voluntary contribution.",bullet4:"Any associated digital item (if applicable) is non-transferable and has no resale value.",bullet5:"Funds are sent directly from your wallet to the creator's wallet.",bullet6:"Valens does not custody, hold, or manage user funds.",disclaimerNote:"By continuing, you confirm that you understand this is a voluntary contribution with no financial expectation.",connectWalletButton:"Connect Wallet to Continue",maybeLater:"Maybe Later",introTitle:"Support this creator?",introDescription:"Your follow is free. If you want, you can financially support {{creatorName}} now.",supportNowButton:"Support now",nahLater:"Nah, later"},termConditionComponent:{heading:"VALENS MASTER SUBSCRIPTOR POLICY",section1Title:"1. Overview",section1Body:"This Master Subscription Policy applies to all users participating in the Valens subscription ecosystem, including Plan Owners and Subscribers. By activating or subscribing, users agree to this policy, including Valens Terms of Use, Privacy Policy, and Payout Policy.",partATitle:"PART A \u2014 TERMS FOR PLAN OWNERS",section2Title:"2. Subscription Plan Creation",section2Body:"When you activate a subscription plan, you become a Plan Owner. You may create private channels, define perks, and set monthly subscription prices between $9.99 USD and $100.00 USD.",section3Title:"3. Platform Fees",section3Sub1Title:"3.1 Monthly Maintenance Fee",section3Sub1Body:"Valens charges $19.99 USD/month for hosting and operating your subscription channel.",section3Sub2Title:"3.2 Withdrawal Fee",section3Sub2Body:"A 5% withdrawal fee applies to every payout request.",section3Sub3Title:"3.3 Billing Authorization",section3Sub3Body:"By enabling your plan, you authorize Valens to charge maintenance fees and deduct payout withdrawal fees automatically.",section4Title:"4. Earnings & Payouts",section4Body:"Earnings are visible in the Creator Dashboard. Payouts follow the Payout Policy. KYC verification is required. You must report earnings to tax authorities.",section5Title:"5. Content Responsibilities",section5Body:"All private content must follow Valens guidelines. Illegal, harmful, abusive, or fraudulent content is prohibited.",section6Title:"6. Account & Compliance Enforcement",section6Body:"Valens may restrict monetization, freeze payouts, remove content, or disable plans upon violations.",partBTitle:"PART B \u2014 TERMS FOR SUBSCRIBERS",section7Title:"7. Subscription Access",section7Body:"Subscribers gain access to exclusive private content and perks. Access is non-transferable.",section8Title:"8. Monthly Billing & Auto-Renewal",section8Body:"By subscribing, you authorize Valens to bill you monthly until cancellation.",section9Title:"9. Cancellation",section9Body:"You may cancel anytime. Access remains until the end of the billing period. No partial refunds.",section10Title:"10. No Refunds",section10Body:"All subscription payments are final and non-refundable, including unused periods.",section11Title:"11. Content Protection",section11Body:"Subscribers may NOT screenshot, record, download, print, or share subscription content. Violations may result in a security block.",partCTitle:"PART C \u2014 GENERAL TERMS",section12Title:"12. Safety & Compliance",section12Body:"All interactions must comply with Valens Community Guidelines and legal requirements.",section13Title:"13. Platform Rights",section13Body:"Valens may update fees, freeze suspicious activity, restrict payouts, or suspend programs.",section14Title:"14. Agreement to Terms",section14Body:"By using subscription features, you agree to this policy and authorize Valens to manage charges and fees.",checkboxLabel:"I agree to the Terms & Conditions",continueButton:"Continue"},tokenPurchase:{loadingPrice:"Loading token price...",title:"Support Tokens",rateLabel:"Current rate: ${{rate}} per token",amountInputLabel:"Token Value Amount",selectTokensLabel:"Select Tokens",breakdownTitle:"Fee Structure & Breakdown",tokenValueLabel:"Token Value",platformFeeLabel:"Platform Fee (5%)",followingFeeLabel:"Following 