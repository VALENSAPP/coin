csRemoveAll:"Eliminar todos los bloques de letras",lyricsLoadRefresh:"Cargar / actualizar letras",lyricsKaraokeLabel:"Karaoke",lyricsTrimSpaced:"Recorte \xb7 espaciado",lyricsTrimCompact:"Recorte \xb7 compacto",lyricsFullSong:"Canci\xf3n completa",lyricsFootnote:"Arrastra las letras para moverlas. Toca \xd7 o mant\xe9n presionado para eliminarlas. El recorte de sonido actualiza el segmento de la forma de onda y mantiene las letras sincronizadas con ese rango (Karaoke).",lyricsErrorChooseSong:"Primero elige una canci\xf3n: abre M\xfasica y selecciona una pista de la b\xfasqueda.",lyricsErrorInstrumental:"Las letras se cargan para canciones del cat\xe1logo buscadas. Las selecciones r\xe1pidas aqu\xed son muestras instrumentales.",lyricsErrorNeedArtist:"Esta pista necesita un nombre de artista para encontrar la letra.",lyricsErrorNotFound:"No se encontraron letras. Prueba otra canci\xf3n o edita el texto manualmente.",lyricsErrorGeneric:"No se pudieron cargar las letras.",lyricsAlertTitle:"Letras",lyricsAlertChooseFirst:"Primero carga las letras.",lyricsAlertNothingToAdd:"No hay nada para agregar en este rango. Ajusta Editar (recortar) o usa la canci\xf3n completa.",addClipsErrorTitle:"No se pudieron agregar clips",addClipsErrorFallback:"Int\xe9ntalo de nuevo o verifica el acceso a la biblioteca de fotos.",cropErrorTitle:"Editar",cropErrorMessage:"No se pudo abrir el recorte para esta imagen.",cropFailedTitle:"Recorte fallido",playPreview:"Reproducir vista previa",pausePreview:"Pausar vista previa"},storyOverlay:{accessibilityDragHint:"Arrastra para reposicionar. Pellizca para cambiar el tama\xf1o. Arrastra a la papelera para eliminar."},activateMissionPost:{noCreditsTitle:"No hay cr\xe9ditos disponibles",bodyIntro:"Est\xe1s a punto de crear una Publicaci\xf3n de Misi\xf3n.",bodyDescription:"Las Publicaciones de Misi\xf3n te permiten compartir algo importante con tu comunidad, ya sea una meta, una idea o un momento significativo, e invitar a otros a apoyar o participar.",creditUnlocks:"Este cr\xe9dito desbloquea una Publicaci\xf3n de Misi\xf3n, que puedes usar para:",bullet1:"Lanzar un proyecto personal",bullet2:"Compartir una causa importante",bullet3:"Pedir apoyo a tu red",bullet4:"Crear un momento alrededor de algo que te importa",bodyFollowers:"Tus seguidores pueden interactuar y apoyar tu misi\xf3n de manera simple y transparente.",unlockCta:"Desbloquea la Publicaci\xf3n de Misi\xf3n para continuar",launchButton:"Lanzar misi\xf3n",notNowButton:"Ahora no"},businessPlanModal:{planTitle:"Tu misi\xf3n empresarial comienza aqu\xed",planMessage:"Valens fue creado para empresas que quieren m\xe1s que seguidores.\n\nActiva tu Plan Empresarial para desbloquear publicaciones de misi\xf3n, canales para suscriptores, anal\xedticas de marca y herramientas dise\xf1adas para convertir la atenci\xf3n en interacci\xf3n real.",price:"Plan Empresarial: $9.90/mes",activateButton:"Activar herramientas empresariales",activating:"Activando...",continueBasic:"Continuar con perfil b\xe1sico",reminderTitle:"Plan Empresarial - $9.90/mes",reminderMessage:"Puedes continuar con un perfil empresarial b\xe1sico, pero algunas funciones permanecer\xe1n bloqueadas hasta que actives el Plan Empresarial.\n\nSin el Plan Empresarial no tendr\xe1s acceso a:\n* Insignia de verificaci\xf3n (Dragonfly)\n* Publicaciones de Misi\xf3n para interactuar con tu audiencia\n* Contenido privado por suscripci\xf3n para seguidores\n* Visibilidad en el marketplace\n* Participaci\xf3n en batallas\n* Anal\xedticas empresariales avanzadas\n\nActiva el Plan Empresarial para desbloquear la experiencia completa de Valens.",unlockButton:"Desbloquear funciones empresariales",processing:"Procesando...",continueBasicLimited:"Continuar con perfil limitado",successTitle:"Felicidades - Tu Plan Empresarial est\xe1 activo"},businessSubscriptionPrompt:{step1Title:"Suscribirse a Valens",step1Body:"Para continuar con las herramientas empresariales, necesitas suscribirte a Valens.",step1Button:"Suscribirse a Valens",step2Title:"Desbloquear funciones empresariales",step2Body:"Para acceder a Publicaciones de Misi\xf3n y Ubicaciones de Marketing, necesitar\xe1s una Suscripci\xf3n Empresarial activa.",featuresTitle:"Con una Suscripci\xf3n Empresarial, puedes:",feature1:"\u2714 Lanzar Publicaciones de Misi\xf3n (campa\xf1as basadas en objetivos)",feature2:"\u2714 Promocionar tu marca con ubicaciones de marketing",feature3:"\u2714 Colaborar con creadores",feature4:"\u2714 Acceder a anal\xedticas avanzadas y herramientas de campa\xf1a",feature5:"\u2714 Crear batallas",feature6:"\u2714 Crear tu tienda",step2BodyFooter:"Tu suscripci\xf3n otorga acceso a herramientas y servicios dentro de Valens.",ctaText:"Activa tu Suscripci\xf3n Empresarial para continuar.",maybeLater:"Quiz\xe1s m\xe1s tarde",activateNow:"Activar ahora",activating:"Procesando..."},buyersList:{followedBy:"Seguido por",supportedBy:"Apoyado por",userSingular:"usuario",userPlural:"usuarios",searchPlaceholder:"Buscar compradores",noMatches:"Sin coincidencias",tryDifferentSearch:"Prueba una b\xfasqueda diferente.",noUsersYet:"A\xfan no hay usuarios",beFirst:"S\xe9 el primero en apoyar esta publicaci\xf3n."},commonSupportModal:{defaultPrimaryLabel:"Apoyar ahora",defaultSecondaryLabel:"Quiz\xe1s m\xe1s tarde",walletNotConnected:"La billetera no est\xe1 conectada para",onceConnected:" Una vez conectada, podr\xe1s apoyar."},connectStripeModal:{message:"Debes completar la configuraci\xf3n de Stripe para recibir pagos de suscripci\xf3n.",cancelButton:"Cancelar",connectButton:"Conectar Stripe"},missionSupportScreen:{title:"\ud83d\udc9c PUBLICACI\xd3N DE MISI\xd3N VALENS",heading:"Financia esta misi\xf3n. Impulsa su visi\xf3n.",description:"Tu contribuci\xf3n ayuda a este creador a completar un objetivo o proyecto espec\xedfico.",noteLabel:"Deja una nota (opcional):",notePlaceholder:"Escribe un breve mensaje de apoyo...",amountLabel:"Elige tu monto de apoyo:",customAmountPlaceholder:"Ingresa el monto",secureText: