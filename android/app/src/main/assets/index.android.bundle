l:"Chiedi pi\xf9 tardi",cameraPermissionNegative:"Annulla",cameraPermissionPositive:"OK",permissionDeniedTitle:"Permesso negato",permissionDeniedMessage:"Il permesso della fotocamera \xe8 richiesto per scattare foto.",cameraErrorTitle:"Errore fotocamera",mediaReadErrorTitle:"Oops",mediaReadErrorMessage:"Impossibile leggere il file multimediale selezionato.",storyUploadSuccess:"Storia caricata con successo",storyUploadFailed:"Caricamento della storia fallito, riprova",storyUploadError:"Qualcosa \xe8 andato storto! Riprova"},creditPurchaseModal:{title:"Acquista crediti Mint",currentCreditsLabel:"Crediti attuali:",selectAmountLabel:"Seleziona l\u2019importo da acquistare:",creditSingular:"credito",creditPlural:"crediti",continueToPayment:"Continua al pagamento",cancelButton:"Annulla",maxCreditsError:"Hai gi\xe0 il numero massimo di crediti.",maxPurchasableError_one:"Puoi acquistare fino a {{count}} credito.",maxPurchasableError_other:"Puoi acquistare fino a {{count}} crediti.",confirmPurchaseTitle:"Conferma acquisto",confirmPurchaseMessage_one:"Acquistare {{count}} credito aggiuntivo?",confirmPurchaseMessage_other:"Acquistare {{count}} crediti aggiuntivi?",confirmCancel:"Annulla",confirmPurchase:"Acquista",onboardingIncomplete:"La configurazione di Stripe non \xe8 ancora completa."},reportFlow:{sheetTitle:"Segnala questo contenuto",sheetSubtitle:"Aiutaci a capire perch\xe9 stai segnalando questo contenuto",confirmTitle:"Segnala questo contenuto",confirmSubtitle:"Prendiamo seriamente il tuo feedback",reasonLabel:"Motivo della segnalazione:",submitButton:"Invia segnalazione",submittingButton:"Invio...",cancelButton:"Annulla",missingPostIdTitle:"Impossibile segnalare",missingPostIdMessage:"ID del post mancante.",noReasonTitle:"Seleziona un motivo",noReasonMessage:"Seleziona un motivo per questa segnalazione.",successTitle:"Segnalazione inviata",successMessage:"Grazie! La tua segnalazione \xe8 stata inviata.",failedTitle:"Segnalazione fallita",reason1:"\xc8 spam",reason2:"Nudit\xe0 o contenuto sessuale",reason3:"Discorso d\u2019odio o simboli",reason4:"Violenza o comportamento pericoloso",reason5:"Informazioni false",reason6:"Bullismo o molestie",reason7:"Truffa o frode"},shareModal:{searchPlaceholder:"Cerca",noFollowingFound:"Nessun utente seguito trovato",sendButton_one:"Invia a {{count}} utente",sendButton_other:"Invia a {{count}} utenti",shareToLabel:"Condividi con",copyLinkLabel:"Copia link",whatsappLabel:"WhatsApp",copiedTitle:"Copiato!",copiedMessage:"Link copiato negli appunti",invalidLinkTitle:"Errore",invalidLinkMessage:"Link di condivisione non valido",loadFollowingError:"Impossibile caricare la lista seguiti",noSelectionTitle:"Nessuna selezione",noSelectionMessage:"Seleziona almeno un utente.",notLoggedInTitle:"Non connesso",notLoggedInMessage:"Effettua nuovamente il login.",sentTitle:"Inviato",sentMessage_one:"Condiviso con {{count}} utente.",sentMessage_other:"Condiviso con {{count}} utenti.",shareErrorTitle:"Errore",shareErrorMessage:"Condivisione fallita",navigationErrorTitle:"Errore",navigationErrorMessage:"Navigazione fallita."},requestModal:{pendingTitle:"Richiesta in sospeso",pendingSubtitle:"Approva o rifiuta nel tuo wallet se richiesto.",resultTitle:"Risultato"},storyViewer:{unknownUser:"Utente sconosciuto",videoStoryBadge:"\ud83c\udfac Storia video",photoStoryBadge:"\ud83d\udcf7 Storia fotografica",timeJustNow:"Proprio ora",timeMinutesAgo:"{{count}} min fa",timeHoursAgo:"{{count}} h fa",timeDaysAgo:"{{count}} g fa",timeRecently:"Recentemente"},subscribeFlow:{step1Subtitle:"Stai per abbonarti!",step1Body:"Sblocca post esclusivi, drop privati e accesso diretto al mondo Valens di questo creator.\n\nIl tuo supporto si trasforma in ricompense in tempo reale \u2014 ogni abbonamento alimenta il suo percorso e il tuo.",confirmQuestion:"Confermare l'abbonamento?",yesButton:"S\xec, ci sto",notNow:"Non ora",membershipLabel:"Abbonamento",perMonth:"/ mese",commentLabel:"Commento:",termsPrefix:"Accetto i",termsLink:"Termini per gli Abbonati Valens",termsSuffix:"e comprendo che gli abbonamenti forniscono solo accesso a contenuti digitali e non sono investimenti o prodotti finanziari.",completePaymentButton:"\u2705 Fatto \u2014 Completa il pagamento",subscriptionAmountNotSet:"Questo creatore non ha ancora impostato un importo di abbonamento.",amountUnavailable:"L'importo dell'abbonamento non \xe8 disponibile. Riprova.",onboardingIncomplete:"La configurazione di Stripe non \xe8 ancora completa."},subscriptionActivation:{title:"Diventa un abbonato privato",chargeIntro:"Verr\xe0 addebitata una quota mensile di",chargeAmount:"$19.90",chargeSuffix:"per attivare il tuo account di abbonato privato.",platformFeesTitle:"Commissioni della piattaforma",maintenanceFee:"\u2022 Commissione mensile di manutenzione di $19.90",maintenanceFeeDesc:"Per ospitare e gestire il tuo canale privato di abbonamento.",withdrawalFee:"\u2022 Commissione di prelievo del ",withdrawalFeeDesc:"Applicata a ogni richiesta di pagamento effettuata.",billingAuthTitle:"Autorizzazione alla fatturazione",billingAuthDesc:"Continuando, autorizzi Valens ad addebitare automaticamente la quota mensile di manutenzione e a detrarre la commissione di prelievo del  dai tuoi pagamenti.",cancelButton:"Annulla",acceptButton:"Accetta"},stripePaymentMethod:{message:"Completa la configurazione di Stripe per aggiungere un metodo di pagamento.",cancelButton:"Annulla",connectButton:"Connetti a Stripe"},supportCreator:{disclaimerTitle:"Supportare \"{{creatorName}}\"?",disclaimerDescription:"Stai per inviare un supporto volontario a questo profilo.\nSolo per informarti:",bullet1:"Questa \xe8 un'azione non finanziaria e non un investimento.",bullet2:"Non sono previsti n\xe9 offerti profitti, ricompense o benefici finanziari.",bullet3:"Il tuo supporto \xe8 un contributo volontario.",bullet4:"Qualsiasi elemento digitale associato (se applicabile) non \xe8 trasferibile e non ha valore di rivendita.",bullet5:"I fondi vengono inviati direttamente dal tuo wallet al wallet del creator.",bullet6:"Valens non custodisce, trattiene o gestisce i fondi degli utenti.",disclaimerNote:"Continuando, confermi di comprendere che si tratta di un contributo volontario senza aspettative finanziarie.",connectWalletButton:"Connetti il wallet per continuare",maybeLater:"Forse pi\xf9 tardi",introTitle:"Supportare questo creator?",introDescription:"Seguire \xe8 gratuito. Se vuoi, puoi supportare economicamente {{creatorName}} ora.",supportNowButton:"Supporta ora",nahLater:"No, pi\xf9 tardi"},termConditionComponent:{heading:"POLITICA PRINCIPALE DI SOTTOSCRIZIONE VALENS",section1Title:"1. Panoramica",section1Body:"Questa Politica Principale di Sottoscrizione si applica a tutti gli utenti che partecipano all'ecosistema di abbonamento Valens, inclusi Proprietari dei Piani e Abbonati. Attivando o sottoscrivendo un abbonamento, gli utenti accettano questa politica, inclusi i Termini di Utilizzo, l'Informativa sulla Privacy e la Politica dei Pagamenti di Valens.",partATitle:"PARTE A \u2014 TERMINI PER I PROPRIETARI DEI PIANI",section2Title:"2. Creazione del Piano di Abbonamento",section2Body:"Quando attivi un piano di abbonamento, diventi un Proprietario del Piano. Puoi creare canali privati, definire vantaggi e impostare prezzi mensili di abbonamento tra $9.99 USD e $100.00 USD.",section3Title:"3. Commissioni della piattaforma",section3Sub1Title:"3.1 Commissione Mensile di Manutenzione",section3Sub1Body:"Valens addebita $19.99 USD/mese per ospitare e gestire il tuo canale di abbonamento.",section3Sub2Title:"3.2 Commissione di Prelievo",section3Sub2Body:"Una commissione di prelievo del 5% si applica a ogni richiesta di pagamento.",section3Sub3Title:"3.3 Autorizzazione di Fatturazione",section3Sub3Body:"Abilitando il tuo piano, autorizzi Valens ad addebitare automaticamente le commissioni di manutenzione e a detrarre le commissioni di prelievo dai pagamenti.",section4Title:"4. Guadagni e Pagamenti",section4Body:"I guadagni sono visibili nella Dashboard Creator. I pagamenti seguono la Politica dei Pagamenti. \xc8 richiesta la verifica KYC. Devi dichiarare i guadagni alle autorit\xe0 fiscali.",section5Title:"5. Responsabilit\xe0 sui Contenuti",section5Body:"Tutti i contenuti privati devono seguire le linee guida di Valens. Sono vietati contenuti illegali, dannosi, abusivi o fraudolenti.",section6Title:"6. Applicazione della Conformit\xe0 dell\u2019Account",section6Body:"Valens pu\xf2 limitare la monetizzazione, congelare i pagamenti, rimuovere contenuti o disabilitare i piani in caso di violazioni.",partBTitle:"PARTE B \u2014 TERMINI PER GLI ABBONATI",section7Title:"7. Accesso all\u2019Abbonamento",section7Body:"Gli abbonati ottengono accesso a contenuti privati esclusivi e vantaggi. L\u2019accesso non \xe8 trasferibile.",section8Title:"8. Fatturazione Mensile e Rinnovo Automatico",section8Body:"Sottoscrivendo un abbonamento, autorizzi Valens ad addebitarti mensilmente fino alla cancellazione.",section9Title:"9. Cancellazione",section9Body:"Puoi annullare in qualsiasi momento. L\u2019accesso rimane fino alla fine del periodo di fatturazione. Nessun rimborso parziale.",section10Title:"10. Nessun Rimborso",section10Body:"Tutti i pagamenti degli abbonamenti sono definitivi e non rimborsabili, inclusi i periodi inutilizzati.",section11Title:"11. Protezione dei Contenuti",section11Body:"Gli abbonati NON possono fare screenshot, registrare, scaricare, stampare o condividere contenuti in abbonamento. Le violazioni possono comportare un blocco di sicurezza.",partCTitle:"PARTE C \u2014 TERMINI GENERALI",section12Title:"12. Sicurezza e Conformit\xe0",section12Body:"Tutte le interazioni devono rispettare le Linee Guida della Community Valens e i requisiti legali.",section13Title:"13. Diritti della Piattaforma",section13Body:"Valens pu\xf2 aggiornare le commissioni, congelare attivit\xe0 sospette, limitare i pagamenti o sospendere programmi.",section14Title:"14. Accettazione dei Termini",section14Body:"Utilizzando le funzionalit\xe0 di abbonamento, accetti questa politica e autorizzi Valens a gestire addebiti e commissioni.",checkboxLabel:"Accetto i Termini e Condizioni",continueButton:"Continua"},tokenPurchase:{loadingPrice:"Caricamento del prezzo del token...",title:"Token di Supporto",rateLabel:"Tasso attuale: ${{rate}} per token",amountInputLabel:"Importo del Valore del Token",selectTokensLabel:"Seleziona Token",breakdownTitle:"Struttura delle Commissioni e Dettaglio",tokenValueLabel:"Valore del Token",platformFeeLabel:"Commissione della Piattaforma (5%)",followingFeeLabel:"Commissione Following (5%)",totalPayableLabel:"Importo Totale da Pagare",youWillReceive:"Riceverai",tokensCount:"{{count}} token",info1:"\u2022 La commissione della piattaforma e la commissione following vengono aggiunte all'importo del valore del token",info2:"\u2022 Il numero di token viene calcolato in base all'importo del valore del token (prima delle commissioni)",info3:"\u2022 Modificando l'importo o i token, l'altro valore verr\xe0 aggiornato automaticamente",purchaseButton:"Acquista Token",purchaseButtonWithDetails:"Acquista {{count}} Token per ${{total}}",processingButton:"Elaborazione...",paymentCompleted:"Pagamento completato!",minAmountError:"L'importo totale da pagare deve essere almeno di $0.50",errorTitle:"Errore",fetchPriceError:"Impossibile recuperare il prezzo del token"},tokenSell:{loading:"Caricamento...",title:"Token Non Supportati",availableLabel:"Disponibili: {{count}} token",tokensToUnsupportLabel:"Token da Rimuovere dal Supporto",usdAmountLabel:"Importo USD",sellButton:"Rimuovi Supporto ai Token per ${{total}}",processingButton:"Elaborazione...",errorTitle:"Errore",sellError:"Impossibile elaborare la vendita dei token. Controlla la connessione e riprova.",fetchAmountError:"Impossibile recuperare l'importo di acquisto dei token",fetchPriceError:"Impossibile recuperare il prezzo del token"},topHolders:{activityTab:"Attivit\xe0",holdersTab:"Detentori",noActivity:"\u2728 Nessuna attivi