,confirmPurchaseMessage_one:"Acheter {{count}} cr\xe9dit suppl\xe9mentaire ?",confirmPurchaseMessage_other:"Acheter {{count}} cr\xe9dits suppl\xe9mentaires ?",confirmCancel:"Annuler",confirmPurchase:"Acheter",onboardingIncomplete:"La configuration Stripe n\u2019est pas encore termin\xe9e."},reportFlow:{sheetTitle:"Signaler ce contenu",sheetSubtitle:"Aidez-nous \xe0 comprendre pourquoi vous signalez ce contenu",confirmTitle:"Signaler ce contenu",confirmSubtitle:"Nous prenons vos retours au s\xe9rieux",reasonLabel:"Motif du signalement :",submitButton:"Envoyer le signalement",submittingButton:"Envoi...",cancelButton:"Annuler",missingPostIdTitle:"Impossible de signaler",missingPostIdMessage:"ID de publication manquant.",noReasonTitle:"S\xe9lectionnez une raison",noReasonMessage:"Veuillez choisir une raison pour ce signalement.",successTitle:"Signalement envoy\xe9",successMessage:"Merci ! Votre signalement a \xe9t\xe9 envoy\xe9.",failedTitle:"\xc9chec du signalement",reason1:"C'est du spam",reason2:"Nudit\xe9 ou contenu sexuel",reason3:"Discours haineux ou symboles",reason4:"Violence ou comportement dangereux",reason5:"Fausse information",reason6:"Intimidation ou harc\xe8lement",reason7:"Arnaque ou fraude"},shareModal:{searchPlaceholder:"Rechercher",noFollowingFound:"Aucun utilisateur suivi trouv\xe9",sendButton_one:"Envoyer \xe0 {{count}} utilisateur",sendButton_other:"Envoyer \xe0 {{count}} utilisateurs",shareToLabel:"Partager avec",copyLinkLabel:"Copier le lien",whatsappLabel:"WhatsApp",copiedTitle:"Copi\xe9 !",copiedMessage:"Lien copi\xe9 dans le presse-papiers",invalidLinkTitle:"Erreur",invalidLinkMessage:"Lien de partage invalide",loadFollowingError:"\xc9chec du chargement de la liste des abonnements",noSelectionTitle:"Aucune s\xe9lection",noSelectionMessage:"Veuillez s\xe9lectionner au moins un utilisateur.",notLoggedInTitle:"Non connect\xe9",notLoggedInMessage:"Veuillez vous reconnecter.",sentTitle:"Envoy\xe9",sentMessage_one:"Partag\xe9 avec {{count}} utilisateur.",sentMessage_other:"Partag\xe9 avec {{count}} utilisateurs.",shareErrorTitle:"Erreur",shareErrorMessage:"\xc9chec du partage",navigationErrorTitle:"Erreur",navigationErrorMessage:"La navigation a \xe9chou\xe9."},requestModal:{pendingTitle:"Demande en attente",pendingSubtitle:"Approuvez ou refusez dans votre portefeuille si demand\xe9.",resultTitle:"R\xe9sultat"},storyViewer:{unknownUser:"Utilisateur inconnu",videoStoryBadge:"\ud83c\udfac Story vid\xe9o",photoStoryBadge:"\ud83d\udcf7 Story photo",timeJustNow:"\xc0 l'instant",timeMinutesAgo:"Il y a {{count}} min",timeHoursAgo:"Il y a {{count}} h",timeDaysAgo:"Il y a {{count}} j",timeRecently:"R\xe9cemment"},subscribeFlow:{step1Subtitle:"Vous \xeates sur le point de vous abonner !",step1Body:"D\xe9bloquez des publications exclusives, des drops priv\xe9s et un acc\xe8s direct \xe0 l\u2019univers Valens de ce cr\xe9ateur.\n\nVotre soutien se transforme en r\xe9compenses en temps r\xe9el \u2014 chaque abonnement alimente son parcours et le v\xf4tre.",confirmQuestion:"Confirmer l'abonnement ?",yesButton:"Oui, j'en suis",notNow:"Pas maintenant",membershipLabel:"Abonnement",perMonth:"/ mois",commentLabel:"Commentaire :",termsPrefix:"J'accepte les",termsLink:"Conditions des Abonn\xe9s Valens",termsSuffix:"et je comprends que les abonnements donnent uniquement acc\xe8s \xe0 du contenu num\xe9rique et ne constituent ni des investissements ni des produits financiers.",completePaymentButton:"\u2705 Termin\xe9 \u2014 Finaliser le paiement",subscriptionAmountNotSet:"Ce cr\xe9ateur n'a pas encore d\xe9fini de montant d'abonnement.",amountUnavailable:"Le montant de l'abonnement n'est pas disponible. Veuillez r\xe9essayer.",onboardingIncomplete:"La configuration Stripe n'est pas encore termin\xe9e."},subscriptionActivation:{title:"Devenir un abonn\xe9 priv\xe9",chargeIntro:"Des frais mensuels de",chargeAmount:"$19.90",chargeSuffix:"seront factur\xe9s pour activer votre compte d\u2019abonn\xe9 priv\xe9.",platformFeesTitle:"Frais de plateforme",maintenanceFee:"\u2022 Frais mensuels de maintenance de 19,90 $",maintenanceFeeDesc:"Pour h\xe9berger et exploiter votre cha\xeene d\u2019abonnement priv\xe9e.",withdrawalFee:"\u2022 Frais de retrait de ",withdrawalFeeDesc:"Appliqu\xe9s \xe0 chaque demande de paiement effectu\xe9e.",billingAuthTitle:"Autorisation de facturation",billingAuthDesc:"En continuant, vous autorisez Valens \xe0 facturer automatiquement les frais mensuels de maintenance et \xe0 d\xe9duire les frais de retrait de de vos paiements.",cancelButton:"Annuler",acceptButton:"Accepter"},stripePaymentMethod:{message:"Veuillez terminer la configuration Stripe pour ajouter un moyen de paiement.",cancelButton:"Annuler",connectButton:"Connecter \xe0 Stripe"},supportCreator:{disclaimerTitle:"Soutenir \"{{creatorName}}\" ?",disclaimerDescription:"Vous \xeates sur le point d\u2019envoyer un soutien volontaire \xe0 ce profil.\nJuste pour information :",bullet1:"Il s'agit d'une action non financi\xe8re et non d'un investissement.",bullet2:"Aucun profit, r\xe9compense ou avantage financier n'est attendu ou offert.",bullet3:"Votre soutien est une contribution volontaire.",bullet4:"Tout \xe9l\xe9ment num\xe9rique associ\xe9 (le cas \xe9ch\xe9ant) est non transf\xe9rable et sans valeur de revente.",bullet5:"Les fonds sont envoy\xe9s directement de votre portefeuille vers celui du cr\xe9ateur.",bullet6:"Valens ne d\xe9tient, ne conserve ni ne g\xe8re les fonds des utilisateurs.",disclaimerNote:"En continuant, vous confirmez comprendre qu'il s'agit d'une contribution volontaire sans attente financi\xe8re.",connectWalletButton:"Connecter le portefeuille pour continuer",maybeLater:"Peut-\xeatre plus tard",introTitle:"Soutenir ce cr\xe9ateur ?",introDescription:"Le suivi est gratuit. Si vous le souhaitez, vous pouvez soutenir financi\xe8rement {{creatorName}} maintenant.",supportNowButton:"Soutenir maintenant",nahLater:"Non, plus tard"},termConditionComponent:{heading:"POLITIQUE PRINCIPALE D\u2019ABONNEMENT VALENS",section1Title:"1. Aper\xe7u",section1Body:"Cette Politique Principale d\u2019Abonnement s\u2019applique \xe0 tous les utilisateurs participant \xe0 l\u2019\xe9cosyst\xe8me d\u2019abonnement Valens, y compris les Propri\xe9taires de Plans et les Abonn\xe9s. En activant ou en souscrivant un abonnement, les utilisateurs acceptent cette politique, y compris les Conditions d\u2019Utilisation, la Politique de Confidentialit\xe9 et la Politique de Paiement de Valens.",partATitle:"PARTIE A \u2014 CONDITIONS POUR LES PROPRI\xc9TAIRES DE PLANS",section2Title:"2. Cr\xe9ation d\u2019un Plan d\u2019Abonnement",section2Body:"Lorsque vous activez un plan d\u2019abonnement, vous devenez un Propri\xe9taire de Plan. Vous pouvez cr\xe9er des canaux priv\xe9s, d\xe9finir des avantages et fixer des prix mensuels d\u2019abonnement entre 9,99 $ USD et 100,00 $ USD.",section3Title:"3. Frais de la plateforme",section3Sub1Title:"3.1 Frais Mensuels de Maintenance",section3Sub1Body:"Valens facture 19,99 $ USD/mois pour h\xe9berger et exploiter votre canal d\u2019abonnement.",section3Sub2Title:"3.2 Frais de Retrait",section3Sub2Body:"Des frais de retrait de 5 % s\u2019appliquent \xe0 chaque demande de paiement.",section3Sub3Title:"3.3 Autorisation de Facturation",section3Sub3Body:"En activant votre plan, vous autorisez Valens \xe0 facturer automatiquement les frais de maintenance et \xe0 d\xe9duire les frais de retrait des paiements.",section4Title:"4. Revenus et Paiements",section4Body:"Les revenus sont visibles dans le Tableau de Bord Cr\xe9ateur. Les paiements suivent la Politique de Paiement. Une v\xe9rification KYC est requise. Vous devez d\xe9clarer vos revenus aux autorit\xe9s fiscales.",section5Title:"5. Responsabilit\xe9s li\xe9es au contenu",section5Body:"Tout contenu priv\xe9 doit respecter les directives de Valens. Les contenus ill\xe9gaux, nuisibles, abusifs ou frauduleux sont interdits.",section6Title:"6. Application de la Conformit\xe9 des Comptes",section6Body:"Valens peut restreindre la mon\xe9tisation, geler les paiements, supprimer du contenu ou d\xe9sactiver des plans en cas de violation.",partBTitle:"PARTIE B \u2014 CONDITIONS POUR LES ABONN\xc9S",section7Title:"7. Acc\xe8s \xe0 l\u2019Abonnement",section7Body:"Les abonn\xe9s obtiennent un acc\xe8s \xe0 du contenu priv\xe9 exclusif et \xe0 des avantages. L\u2019acc\xe8s est non transf\xe9rable.",section8Title:"8. Facturation Mensuelle et Renouvellement Automatique",section8Body:"En vous abonnant, vous autorisez Valens \xe0 vous facturer mensuellement jusqu\u2019\xe0 l\u2019annulation.",section9Title:"9. Annulation",section9Body:"Vous pouvez annuler \xe0 tout moment. L\u2019acc\xe8s reste actif jusqu\u2019\xe0 la fin de la p\xe9riode de facturation. Aucun remboursement partiel.",section10Title:"10. Aucun Remboursement",section10Body:"Tous les paiements d\u2019abonnement sont d\xe9finitifs et non remboursables, y compris les p\xe9riodes non utilis\xe9es.",section11Title:"11. Protection du Contenu",section11Body:"Les abonn\xe9s NE peuvent PAS capturer d\u2019\xe9cran, enregistrer, t\xe9l\xe9charger, imprimer ou partager le contenu d\u2019abonnement. Les violations peuvent entra\xeener un blocage de s\xe9curit\xe9.",partCTitle:"PARTIE C \u2014 CONDITIONS G\xc9N\xc9RALES",section12Title:"12. S\xe9curit\xe9 et Conformit\xe9",section12Body:"Toutes les interactions doivent respecter les Directives Communautaires Valens et les exigences l\xe9gales.",section13Title:"13. Droits de la Plateforme",section13Body:"Valens peut mettre \xe0 jour les frais, geler des activit\xe9s suspectes, restreindre les paiements ou suspendre des programmes.",section14Title:"14. Acceptation des Conditions",section14Body:"En utilisant les fonctionnalit\xe9s d\u2019abonnement, vous acceptez cette politique et autorisez Valens \xe0 g\xe9rer les frais et paiements.",checkboxLabel:"J\u2019accepte les Termes et Conditions",continueButton:"Continuer"},tokenPurchase:{loadingPrice:"Chargement du prix du token...",title:"Tokens de soutien",rateLabel:"Taux actuel : ${{rate}} par token",amountInputLabel:"Montant de la Valeur du Token",selectTokensLabel:"S\xe9lectionner des Tokens",breakdownTitle:"Structure des Frais et D\xe9tail",tokenValueLabel:"Valeur du Token",platformFeeLabel:"Frais de Plateforme (5 %)",followingFeeLabel:"Frais de Suivi (5 %)",totalPayableLabel:"Montant Total \xe0 Payer",youWillReceive:"Vous recevrez",tokensCount:"{{count}} tokens",info1:"\u2022 Les frais de plateforme et de suivi sont ajout\xe9s au montant de la valeur du token",info2:"\u2022 Le nombre de tokens est calcul\xe9 \xe0 partir du montant de la valeur du token (avant frais)",info3:"\u2022 Ajuster le montant ou les tokens mettra automatiquement \xe0 jour l\u2019autre valeur",purchaseButton:"Acheter des Tokens",purchaseButtonWithDetails:"Acheter {{count}} Tokens pour ${{total}}",processingButton:"Traitement...",paymentCompleted:"Paiement effectu\xe9 !",minAmountError:"Le montant total \xe0 payer doit \xeatre d\u2019au moins 0,50 $",errorTitle:"Erreur",fetchPriceError:"\xc9chec de r\xe9cup\xe9ration du prix du token"},tokenSell:{loading:"Chargement...",title:"Tokens sans soutien",availableLabel:"Disponible : {{count}} tokens",tokensToUnsupportLabel:"Tokens \xe0 Retirer du Soutien",usdAmountLabel:"Montant en USD",sellButton:"Retirer le soutien des Tokens pour ${{total}}",processingButton:"Traitement...",errorTitle:"Erreur",sellError:"\xc9chec du traitement de la vente des tokens. Veuillez v\xe9rifier votre connexion et r\xe9essayer.",fetchAmountError:"\xc9chec de r\xe9cup\xe9ration du montant d\u2019achat des tokens",fetchPriceError:"\xc9chec de r\xe9cup\xe9ration du prix du token"},topHolders:{activityTab:"Activit\xe9",holdersTab:"D\xe9tenteurs",noActivity:"\u2728 Aucune activit\xe9 pour le moment",noActivitySub:"Achetez pour lancer le march\xe9",buyButton:"Acheter",marketLabel:"March\xe9",userLabel:"Utilisateur",youLabel:"Utilisateur (vous)"},tradeModal:{followTab:"Suivre",unfollowTab:"Ne plus suivr