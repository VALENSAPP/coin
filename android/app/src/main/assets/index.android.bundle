erralCodeLabel:"Codice referral:",deepLinkLabel:"Deep Link:",copiedTitle:"Copiato!",copiedReferralMessage:"Codice referral copiato con successo",copiedLinkMessage:"Link referral copiato negli appunti",shareMessage:"Unisciti a Valens e guadagna ricompense! Usa il mio codice referral:",shareTitle:"Unisciti a Valens"},openBattle:{screenTitle:"Crea Battaglia",heroTitle:"Configura la tua battaglia",heroSubtitle:"Scegli il formato, aggiungi i dettagli richiesti e pubblica.",battleFormatSection:"Formato Battaglia",formatPollTitle:"Sondaggio Battaglia",formatPollSubtitle:"Aggiungi domanda e opzioni di risposta",formatHeadToHeadTitle:"Testa a Testa",formatHeadToHeadSubtitle:"Aggiungi domanda e invita un altro utente",questionLabel:"Domanda",questionPlaceholder:"Scrivi la tua domanda per la battaglia",optionsLabel:"Opzioni",battleSidesLabel:"Lati della Battaglia",addOption:"+ Aggiungi Opzione",optionPlaceholder:"Opzione {{number}}",sidePlaceholder:"Lato {{number}}",inviteUserLabel:"Invita Utente",inviteSearchPlaceholder:"Cerca Utente",inviteHelperText:"La modalit\xe0 testa a testa richiede l'utente che vuoi sfidare. Seleziona un utente e useremo il suo ID per l'invito.",battleSidesHelperText:"Aggiungi i due lati di questo duello. Gli utenti sceglieranno un lato dalla battaglia in corso.",endTimeLabel:"Ora di Fine",endTimePlaceholder:"Seleziona ora di fine",stakeLabel:"Puntata (Opzionale)",stakePlaceholder:"0",publicBattleLabel:"Battaglia Pubblica",publicBattleHelper:"Mantieni attiva questa opzione per creare una battaglia pubblica.",createButton:"CREA BATTAGLIA",helpAlertTitle:"Formato Battaglia",helpAlertMessage:"Il sondaggio richiede una domanda e opzioni. Testa a testa richiede una domanda, due lati e l'utente invitato.",questionRequired:"La domanda \xe8 obbligatoria",optionsMinTwo:"Aggiungi almeno 2 opzioni",optionsDuplicate:"Le opzioni duplicate non sono consentite",endTimeRequired:"L'ora di fine \xe8 obbligatoria",endTimeFuture:"L'ora di fine deve essere nel futuro",inviteUserRequired:"Aggiungi l'utente che vuoi invitare",headToHeadSidesRequired:"Aggiungi 2 lati per la modalit\xe0 testa a testa",stakeInvalid:"La puntata deve essere un numero valido",fixFieldsError:"Correggi i campi evidenziati.",battleCreatedSuccess:"Battaglia creata con successo",battleCreatedFail:"Impossibile creare la battaglia",somethingWentWrong:"Qualcosa \xe8 andato storto",permissionDenied:"Permesso Negato",cameraPermissionRequired:"Il permesso della fotocamera \xe8 richiesto per scattare foto.",failedToPickImage:"Impossibile selezionare l'immagine",failedToCaptureImage:"Impossibile catturare l'immagine",addImageTitle:"Aggiungi Immagine",chooseFromGallery:"Scegli dalla Galleria",chooseFromGallerySubtitle:"Seleziona un'immagine esistente",takeAPhoto:"Scatta una Foto",takeAPhotoSubtitle:"Cattura una nuova immagine",cancel:"Annulla"},profileBattle:{defaultTitle:"Battaglia"},shareProfile:{headerTitle:"Condividi Profilo",scanOrShare:"Scansiona o condividi il link qui sotto",copyLink:"Copia Link",save:"Salva",share:"Condividi",profileLinkCopied:"Link del profilo copiato \u2705",qrSavedToGallery:"QR salvato nella galleria \u2705",permissionDenied:"Permesso Negato",qrNotReady:"QR non pronto",captureFailed:"Impossibile salvare il QR",errorTitle:"Errore",shareErrorTitle:"Errore",shareErrorMessage:"Errore durante la condivisione del contenuto: {{error}}",profileNotAvailable:"Profilo non disponibile",profileNotAvailableMessage:"Impossibile condividere il profilo in questo momento.",linkUnavailable:"Link non disponibile",noLinkToCopy:"Nessun link disponibile da copiare",shareMessageTemplate:"\u2728 Seguimi su Valens\n Unisciti alle mie battaglie, supporta le mie missioni e fai parte del mio mondo. Dove la reputazione si guadagna, non si compra.",shareOtherMessageTemplate:"\u2728 Segui {{username}} su Valens\nDove la reputazione si guadagna, non si compra.\nUnisciti al suo mondo qui sotto.\n{{profileLink}}",brandName:"Valens"},termCondition:{screenTitle:"POLITICA PRINCIPALE DI ABBONAMENTO VALENS",section1Title:"1. Panoramica",section1Text:"Questa Politica Principale di Abbonamento si applica a tutti gli utenti che partecipano all'ecosistema di abbonamento Valens, inclusi Proprietari dei Piani e Abbonati. Attivando o sottoscrivendo un abbonamento, gli utenti accettano questa politica, inclusi i Termini di Utilizzo, la Privacy Policy e la Politica sui Pagamenti di Valens.",partATitle:"PARTE A \u2014 TERMINI PER GLI ABBONATI",section2Title:"2. Accesso all'Abbonamento",section2Text:"Gli abbonati ottengono accesso a contenuti privati esclusivi e vantaggi. L'accesso non \xe8 trasferibile.",section3Title:"3. Fatturazione Mensile e Rinnovo Automatico",section3Text:"Abbonandoti, autorizzi Valens ad addebitarti mensilmente fino alla cancellazione.",section4Title:"4. Cancellazione",section4Text:"Puoi cancellare in qualsiasi momento. L'accesso rimane fino alla fine del periodo di fatturazione. Nessun rimborso parziale.",section5Title:"5. Nessun Rimborso",section5Text:"Tutti i pagamenti degli abbonamenti sono definitivi e non rimborsabili, inclusi i periodi non utilizzati.",section6Title:"6. Protezione dei Contenuti",section6Text:"Gli abbonati NON possono fare screenshot, registrare, scaricare, stampare o condividere contenuti dell'abbonamento. Le violazioni possono comportare un blocco di sicurezza.",partBTitle:"PARTE B \u2014 TERMINI GENERALI",section7Title:"7. Sicurezza e Conformit\xe0",section7Text:"Tutte le interazioni devono essere conformi alle Linee Guida della Community Valens e ai requisiti legali.",section8Title:"8. Diritti della Piattaforma",section8Text:"Valens pu\xf2 aggiornare le commissioni, congelare attivit\xe0 sospette, limitare i pagamenti o sospendere programmi.",section9Title:"9. Accettazione dei Termini",section9Text:"Utilizzando le funzionalit\xe0 di abbonamento, accetti questa politica e autorizzi Valens a gestire addebiti e commissioni."},profileEdit:{saveButton:"Save",changeProfilePicture:"Change profile picture",disp