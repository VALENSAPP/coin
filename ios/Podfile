# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'valens' do
  config = use_native_modules!

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++14'
        end
      end
    end

    # Xcode 26+: StripeSwiftInterop.h must match Swift's STPPaymentStatus (NSInteger).
    stripe_interop = File.join(__dir__, '..', 'node_modules/@stripe/stripe-react-native/ios/StripeSwiftInterop.h')
    if File.exist?(stripe_interop)
      text = File.read(stripe_interop)
      patched = text.gsub(
        'typedef NS_ENUM(NSUInteger, STPPaymentStatus);',
        'typedef NS_ENUM(NSInteger, STPPaymentStatus);'
      )
      if patched != text
        File.write(stripe_interop, patched)
        Pod::UI.puts 'Patched StripeSwiftInterop.h for Xcode 26 (STPPaymentStatus NSInteger)'.green
      end
    end

    installer.pods_project.targets.each do |target|
      if target.name == 'StripePayments'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXHeadersBuildPhase)
            phase.files.each do |file|
              if file.file_ref && file.file_ref.path && file.file_ref.path.include?('Stripe3DS2')
                phase.remove_build_file(file)
              end
            end
          end
        end
      end
    end
  end
end
