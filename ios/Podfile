# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'valens' do
  config = use_native_modules!

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 / Clang: fmt's C++20 consteval format strings fail to compile.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] unless defs.is_a?(Array)
          defs << 'FMT_USE_CONSTEVAL=0' unless defs.any? { |d| d.to_s.include?('FMT_USE_CONSTEVAL') }
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end
      end
    end
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files/fmt/*.xcconfig')).each do |path|
      text = File.read(path)
      text.gsub!(/CLANG_CXX_LANGUAGE_STANDARD\s*=\s*c\+\+\d+/, 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      unless text.include?('FMT_USE_CONSTEVAL')
        text.gsub!(
          /GCC_PREPROCESSOR_DEFINITIONS\s*=\s*(.*)$/,
          'GCC_PREPROCESSOR_DEFINITIONS = \\1 FMT_USE_CONSTEVAL=0'
        )
        unless text.include?('FMT_USE_CONSTEVAL')
          text << "\nGCC_PREPROCESSOR_DEFINITIONS = $(inherited) FMT_USE_CONSTEVAL=0\n"
        end
      end
      File.write(path, text)
    end
    fmt_base = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base)
      text = File.read(fmt_base)
      unless text.include?("#ifndef FMT_USE_CONSTEVAL\n#if !defined(__cpp_lib_is_constant_evaluated)")
        text.sub!(
          "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#if !defined(__cpp_lib_is_constant_evaluated)",
          "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#ifndef FMT_USE_CONSTEVAL\n#if !defined(__cpp_lib_is_constant_evaluated)"
        )
        text.sub!(
          "#else\n#  define FMT_USE_CONSTEVAL 0\n#endif\n#if FMT_USE_CONSTEVAL",
          "#else\n#  define FMT_USE_CONSTEVAL 0\n#endif\n#endif\n#if FMT_USE_CONSTEVAL"
        )
        File.write(fmt_base, text)
        Pod::UI.puts 'Patched fmt/base.h to honor FMT_USE_CONSTEVAL=0'.green
      end
    end
    fmt_pch = File.join(installer.sandbox.root, 'Target Support Files/fmt/fmt-prefix.pch')
    if File.exist?(fmt_pch)
      pch = File.read(fmt_pch)
      unless pch.include?('FMT_USE_CONSTEVAL')
        pch.sub!('#ifdef __OBJC__', "#ifdef __cplusplus\n#ifndef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#endif\n#endif\n\n#ifdef __OBJC__")
        File.write(fmt_pch, pch)
      end
    end

    # Xcode 26+: StripeSwiftInterop.h must match Swift's STPPaymentStatus (NSInteger).
    stripe_interop = File.join(__dir__, '..', 'node_modules/@stripe/stripe-react-native/ios/StripeSwiftInterop.h')
    if File.exist?(stripe_interop)
      text = File.read(stripe_interop)
      patched = text.gsub(
        'typedef NS_ENUM(NSUInteger, STPPaymentStatus);',
        'typedef NS_ENUM(NSInteger, STPPaymentStatus);'
      )
      if patched != text
        File.write(stripe_interop, patched)
        Pod::UI.puts 'Patched StripeSwiftInterop.h for Xcode 26 (STPPaymentStatus NSInteger)'.green
      end
    end

    installer.pods_project.targets.each do |target|
      if target.name == 'StripePayments'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXHeadersBuildPhase)
            phase.files.each do |file|
              if file.file_ref && file.file_ref.path && file.file_ref.path.include?('Stripe3DS2')
                phase.remove_build_file(file)
              end
            end
          end
        end
      end
    end
  end
end
