# Copy to `.env` in the project root.
# Metro runs `scripts/writeEnvShim.js` on start and generates `src/shims/env.js`.
BASE_URL=
API_PARAM=

# YouTube Data API v3 key (Google Cloud Console → enable "YouTube Data API v3").
YOUTUBE_DATA_API_KEY=

# Google Places + Geocoding (post location autocomplete).
GOOGLE_PLACES_API_KEY=
